<Project Sdk="Microsoft.NET.Sdk">

	<!-- Shared build layer. Two lines per props file, and only one of them ever matches: locally
	     Workspace is a sibling of this folder, in CI it is checked out INTO this repo. -->
	<Import Project="$(MSBuildThisFileDirectory)../Workspace/build/GameRefs.props" Condition="Exists('$(MSBuildThisFileDirectory)../Workspace/build/GameRefs.props')" />
	<Import Project="$(MSBuildThisFileDirectory)Workspace/build/GameRefs.props" Condition="Exists('$(MSBuildThisFileDirectory)Workspace/build/GameRefs.props')" />
	<Import Project="$(MSBuildThisFileDirectory)../Workspace/build/Deploy.props" Condition="Exists('$(MSBuildThisFileDirectory)../Workspace/build/Deploy.props')" />
	<Import Project="$(MSBuildThisFileDirectory)Workspace/build/Deploy.props" Condition="Exists('$(MSBuildThisFileDirectory)Workspace/build/Deploy.props')" />
	<Import Project="$(MSBuildThisFileDirectory)../Workspace/build/Hardening.props" Condition="Exists('$(MSBuildThisFileDirectory)../Workspace/build/Hardening.props')" />
	<Import Project="$(MSBuildThisFileDirectory)Workspace/build/Hardening.props" Condition="Exists('$(MSBuildThisFileDirectory)Workspace/build/Hardening.props')" />
	<Import Project="$(MSBuildThisFileDirectory)../Workspace/build/ModVersion.props" Condition="Exists('$(MSBuildThisFileDirectory)../Workspace/build/ModVersion.props')" />
	<Import Project="$(MSBuildThisFileDirectory)Workspace/build/ModVersion.props" Condition="Exists('$(MSBuildThisFileDirectory)Workspace/build/ModVersion.props')" />

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<RootNamespace>InventoryExpansion</RootNamespace>
		<LangVersion>latest</LangVersion>
		<IsPackable>false</IsPackable>
		<NeutralLanguage>en-US</NeutralLanguage>
		<AssemblyName>InventoryExpansion</AssemblyName>
		<!-- The real version comes from the release tag as -p:Version and reaches MelonInfo through
		     DooDesch.ModVersion.Current (Workspace/build/ModVersion.props). -->
		<Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
	</PropertyGroup>

	<!-- On top of the five in GameRefs.props. Each one is here because the compiler named it. -->
	<ItemGroup>
		<Reference Include="Unity.InputSystem">
			<HintPath>$(GameManagedPath)/Unity.InputSystem.dll</HintPath>
		</Reference>
		<Reference Include="Unity.TextMeshPro">
			<HintPath>$(GameManagedPath)/Unity.TextMeshPro.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.UI">
			<HintPath>$(GameManagedPath)/UnityEngine.UI.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.ImageConversionModule">
			<HintPath>$(GameManagedPath)/UnityEngine.ImageConversionModule.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.UIModule">
			<HintPath>$(GameManagedPath)/UnityEngine.UIModule.dll</HintPath>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<!-- Embedded so the backpack image ships inside the DLL. Release zips do not include the loose
		     asset, and the runtime loads it from the embedded resource (with an external-file override). -->
		<EmbeddedResource Include="Assets\Backpack.png" />
	</ItemGroup>

	<!-- The DLL copy itself lives in Deploy.props. Only the loose asset is mod specific: it is the
	     external-file override the runtime prefers over the embedded copy, so a test install needs it
	     next to the DLL. -->
	<Target Name="DeployBackpackAsset" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
		<Exec Condition="Exists('$(ModsDirectory)') And Exists('$(TargetDir)Assets\Backpack.png')"
		      Command="cmd /c if not exist &quot;$(ModsDirectory)\Assets&quot; mkdir &quot;$(ModsDirectory)\Assets&quot; &amp;&amp; copy /Y &quot;$(TargetDir)Assets\Backpack.png&quot; &quot;$(ModsDirectory)\Assets\Backpack.png&quot;"
		      ContinueOnError="true" />
	</Target>

</Project>
